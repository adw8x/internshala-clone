# Copy this file to .env.local and fill in your own values.
# Do NOT commit real credentials.

# Base URL used by axios for API calls. In Vercel / local Next.js this stays /api
# (the Next.js API routes proxy to MongoDB directly).
NEXT_PUBLIC_API_BASE_URL=/api

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# Password-reset / OTP email (Gmail SMTP + an App Password from Google account settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Your App <your.email@gmail.com>"

# Base URL for reset links (falls back to the request's origin).
# Set to your deployed domain once live, e.g. https://your-app.vercel.app
#APP_URL=

# Optional email-to-SMS carrier gateway (free). Example: tmomail.net, vtext.com, txt.att.net
#SMS_GATEWAY_DOMAIN=

# MongoDB connection string used at runtime by the Next.js API routes.
DATABASE_URL="mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/internshala?retryWrites=true&w=majority"